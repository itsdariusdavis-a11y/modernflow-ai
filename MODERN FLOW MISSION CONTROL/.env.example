# Copy to .env for local dev. Never commit .env.
# On Netlify, set these same five in Site configuration → Environment variables.

# The Sheet's ID — the long string between /d/ and /edit in its URL.
GOOGLE_SHEET_ID=

# Service account email, ends in .iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The private_key value from the service account JSON, including the BEGIN/END
# lines. Keep it on one line with literal \n escapes, wrapped in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# The shared passcode both of you type at login.
APP_PASSCODE=

# Random 32+ char string used to sign session tokens. Rotating it signs everyone out.
APP_SECRET=
